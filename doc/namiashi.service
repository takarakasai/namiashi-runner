# namiashi 制御ループの systemd ユニット
#
# インストール:
#   sudo cp ~/work/namiashi-runner/doc/namiashi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl start namiashi        # 手動起動で試す
#   journalctl -u namiashi -f            # ログを見る
#
# 電源投入で自動起動させるのは、手動起動で挙動を確認してから:
#   sudo systemctl enable namiashi
#
# 停止は必ず systemctl で（SIGTERM が脱力シーケンスに入る）:
#   sudo systemctl stop namiashi
#
# 設計の根拠は doc/runtime_tuning.md 「RT 優先度の付与」を参照。
#
# --- 本番の投入手順（順番が重要） ---
#   1. ロボットを**伏せ姿勢**にしてからモータ電源を入れる。
#      これを守らないと 12 軸の zero_pose_rad が全て無効になる。
#
#      サービス化で怖くなるのはここ。SBC はモータと同じ電源から作っているので
#      **SBC を再起動すると motor 側のマルチターン基準も一緒にリセットされる**。
#      手動起動なら「姿勢を直してから起動」できていたが、自動起動では電源投入と
#      同時に走り出す。伏せ以外の姿勢で電源を入れた回は、起動ログの
#      「マルチターンフレームを確立しました（オフセット ...）」が前回と別の値になる。
#      ここが変わっていたら zero_pose_rad は無効で、関節角は全部ずれている。
#      毎回この行を見て、前回と同じ値であることを確認すること。
#   2. プロポの電源を入れ、CH5 を**脱力**位置にする。
#   3. SBC の電源を入れる（enable 済みなら自動起動）。
#      **本番会場では PC を繋げないので enable は必須。**
#      2 が済んでいなくても、済ませた時点で自動的に立ち上がる（下記 Restart= 参照）。
#   4. `journalctl -u namiashi -f` で「マルチターンフレーム」のオフセットが
#      前回と同じことと「制御ループ開始」を確認してから CH5 を動かす。

[Unit]
Description=namiashi quadruped control loop
Documentation=file:///home/takara/work/namiashi-runner/doc/runtime_tuning.md

# CH348 の tty が生えてから起動する。ch9344 は USB 接続時に udev がロードする。
# BindsTo により、USB を抜くとサービスも停止する。
After=dev-ttyCH9344USB0.device
BindsTo=dev-ttyCH9344USB0.device

# ネットワークには依存しない。本番の操縦は S.BUS(UART6) 経由のプロポ。
After=basic.target

# 起動レート制限は無効にする。
#
# 制限を残すと、プロポの電源を入れるのが 5 回×3 秒 = 15 秒より遅れただけで
# ユニットが failed のまま固まる。**会場では PC を繋げないので、そうなったら
# 電源を入れ直すしか手が無い。** 起動条件が整うまで何分でも待てる方がよい。
#
# 再起動が暴走しても実害が無いのは、`run` が CH5 脱力位置でなければ起動を
# 拒否するため。ロボットは操縦者が CH5 を操作するまで何もしない。
StartLimitIntervalSec=0

[Service]
Type=simple
User=takara
SupplementaryGroups=dialout
WorkingDirectory=/home/takara/work/namiashi-runner
ExecStart=/home/takara/work/namiashi-runner/target/release/namiashi run --config config/namiashi.toml

# --- リアルタイム優先度 ---
# systemd が付与するので、アプリ側に CAP_SYS_NICE も rtprio 制限も不要。
# プロセスの全スレッド（制御ループ / leg-FL..RR / imu / sbus）が SCHED_FIFO になる。
#
# 50 は handover.md §5.5 の `chrt -f 50` に合わせた値。
# これ以上上げるのは推奨しない（ksoftirqd 餓死のリスク）。
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=50

LimitRTPRIO=95
LimitMEMLOCK=infinity

# 脚バスの二重掴みは /run/lock/namiashi-legs.lock の flock で防いでいる
# （namiashi-hal の LegsLock）。**PrivateTmp= や PrivateDevices=、
# ProtectSystem=strict をここに足すと、その名前空間が分かれて排他が黙って
# 効かなくなる。** 足すなら BindPaths= で /run/lock を共有すること。
#
# 二重に走ると RS485 の応答が取り違えられ、通信エラーにならないまま
# 関節角だけが壊れる。サービス化の初日に実際に起きた（18:10:51 に 2 プロセス）。

# --- 自動再起動: どの失敗でも再試行する ---
#
# 当初は「起動条件待ち（終了コード 75）だけ再起動し、クラッシュでは再起動
# しない」設計にしていた。自動再起動で**脚が再び動き出す**のを避けるためだが、
# **本番会場では PC を繋げない**という条件でこれを見直した。
#
# 再起動しても脚が勝手に動くことはない。`run` は起動時に **CH5 が脱力位置に
# ないと起動を拒否する**（拒否は 75 で、また再試行される）。つまり再起動後の
# ロボットは、操縦者が CH5 を脱力に戻すまで何もしない。動き出すには操縦者が
# 明示的に CH5 を操作する必要があり、これが人による確認そのものになっている。
#
# この前提が付くと、両者の損得が逆転する:
#   再起動する  … 試合中に落ちても、CH5 を脱力に戻せば復帰する。PC は要らない。
#   再起動しない… 落ちた時点でロボットが死ぬ。復帰手段は電源の入れ直しだけで、
#                  しかも伏せ姿勢に直さないとマルチターン原点が壊れる。
#
# 会場で取れる手段が電源とプロポしかない以上、前者を選ぶ。
# 暴走の心配は CH5 の門で頭打ちになる（StartLimitIntervalSec=0 の項も参照）。
#
# なお runner 側の 75 / 1 の返し分けはログの区別（「待機:」対「エラー:」）として
# 残してある。詳細は crates/namiashi-runner/src/runner.rs の RETRYABLE を参照。
Restart=on-failure
RestartSec=3

# SIGTERM は脱力シーケンスに入る（runner.rs の SHUTDOWN フラグ）。
# 実測の終了時間は約 3.2 秒なので 15 秒あれば足りる。
# 落ちなければ SIGKILL になり、モータは最後の指令を保持したままになる。
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
# 注意: これは「電源投入 → S.BUS 応答」を 1.6 秒遅らせる設定である。
#
# CH348 の tty は 3.398 s、multi-user.target は 3.489 s なので、現状の差は
# 91 ms しかない。しかし ch9344 を先読みして tty を 1.84 s に前倒しすると、
# 律速がこの行に移る。namiashi はネットワークにもログインセッションにも
# 依存しないので、multi-user.target を待つ理由は本来無い。
#
# 詳細と測定値: doc/boot_config.md「CH348 の tty 生成が 1.764 秒待たされている」
# サービス投入時に ch9344 の先読みとセットで見直すこと。
WantedBy=multi-user.target
